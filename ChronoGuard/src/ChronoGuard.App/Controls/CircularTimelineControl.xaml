<UserControl x:Class="ChronoGuard.App.Controls.CircularTimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <!-- Temperature gradient for the timeline -->
        <LinearGradientBrush x:Key="TemperatureTimelineGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF6B47" Offset="0"/>    <!-- Very warm -->
            <GradientStop Color="#FF8C42" Offset="0.2"/>  <!-- Warm -->
            <GradientStop Color="#FFA500" Offset="0.4"/>  <!-- Moderate warm -->
            <GradientStop Color="#FFD700" Offset="0.6"/>  <!-- Neutral -->
            <GradientStop Color="#87CEEB" Offset="0.8"/>  <!-- Cool -->
            <GradientStop Color="#4169E1" Offset="1"/>    <!-- Cold -->
        </LinearGradientBrush>

        <!-- Style for time labels -->
        <Style x:Key="TimeLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B4BEFE"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Style for solar event markers -->
        <Style x:Key="SolarEventMarker" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Stroke" Value="#FFD700"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Viewbox Stretch="Uniform">
            <Canvas Width="280" Height="280" Background="Transparent">
                <!-- Outer ring for time markers -->
                <Ellipse x:Name="OuterRing" 
                         Width="280" Height="280" 
                         Stroke="#30FFFFFF" StrokeThickness="1" 
                         Fill="Transparent"/>

                <!-- Main timeline circle -->
                <Ellipse x:Name="TimelineCircle" 
                         Width="240" Height="240" 
                         Canvas.Left="20" Canvas.Top="20"
                         Stroke="{StaticResource TemperatureTimelineGradient}" 
                         StrokeThickness="6" 
                         Fill="Transparent">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#667EEA" BlurRadius="10" Opacity="0.6" ShadowDepth="0"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Inner circle for current time indicator -->
                <Ellipse x:Name="InnerCircle" 
                         Width="200" Height="200" 
                         Canvas.Left="40" Canvas.Top="40"
                         Stroke="#20FFFFFF" StrokeThickness="1" 
                         Fill="Transparent"/>

                <!-- Current time indicator -->
                <Ellipse x:Name="CurrentTimeIndicator" 
                         Width="12" Height="12" 
                         Fill="#F093FB" 
                         Canvas.Left="134" Canvas.Top="14">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#F093FB" BlurRadius="8" Opacity="0.8" ShadowDepth="0"/>
                    </Ellipse.Effect>
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="CurrentTimeRotation" CenterX="6" CenterY="126"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Sunrise indicator -->
                <Canvas x:Name="SunriseIndicator" Canvas.Left="134" Canvas.Top="20">
                    <Ellipse Style="{StaticResource SolarEventMarker}" Fill="#FFD700"/>
                    <Path Data="M -4,-8 L 4,-8 M 0,-12 L 0,-4 M -3,-10 L 3,-10" 
                          Stroke="#FFD700" StrokeThickness="1.5"/>
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="SunriseRotation" CenterX="6" CenterY="120"/>
                    </Canvas.RenderTransform>
                </Canvas>

                <!-- Sunset indicator -->
                <Canvas x:Name="SunsetIndicator" Canvas.Left="134" Canvas.Top="20">
                    <Ellipse Style="{StaticResource SolarEventMarker}" Fill="#FF6B47"/>
                    <Path Data="M -4,8 L 4,8 M 0,4 L 0,12 M -3,6 L 3,6" 
                          Stroke="#FF6B47" StrokeThickness="1.5"/>
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="SunsetRotation" CenterX="6" CenterY="120"/>
                    </Canvas.RenderTransform>
                </Canvas>

                <!-- Time markers (12, 3, 6, 9) -->
                <TextBlock Text="12" Style="{StaticResource TimeLabel}" 
                           Canvas.Left="135" Canvas.Top="5"/>
                <TextBlock Text="6" Style="{StaticResource TimeLabel}" 
                           Canvas.Left="135" Canvas.Top="265"/>
                <TextBlock Text="3" Style="{StaticResource TimeLabel}" 
                           Canvas.Left="265" Canvas.Top="135"/>
                <TextBlock Text="9" Style="{StaticResource TimeLabel}" 
                           Canvas.Left="5" Canvas.Top="135"/>

                <!-- Center content -->
                <StackPanel Canvas.Left="90" Canvas.Top="110" Width="100">
                    <TextBlock x:Name="CurrentTemperatureText" 
                               Text="6500K" 
                               FontFamily="Segoe UI Variable Display"
                               FontSize="24" 
                               FontWeight="SemiBold"
                               Foreground="#CDD6F4"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CurrentPhaseText" 
                               Text="Día"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="14" 
                               Foreground="#9399B2"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="NextEventText" 
                               Text="Atardecer en 4h 23m"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="11" 
                               Foreground="#6C7086"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Temperature zone indicators -->
                <Canvas x:Name="TemperatureZones" Opacity="0.3">
                    <!-- Day zone arc -->
                    <Path x:Name="DayZoneArc" 
                          Stroke="#FFD700" StrokeThickness="4" 
                          Fill="Transparent" Opacity="0.6"/>
                    
                    <!-- Night zone arc -->
                    <Path x:Name="NightZoneArc" 
                          Stroke="#4169E1" StrokeThickness="4" 
                          Fill="Transparent" Opacity="0.6"/>

                    <!-- Transition zones -->
                    <Path x:Name="SunriseZoneArc" 
                          Stroke="#FFA500" StrokeThickness="2" 
                          Fill="Transparent" Opacity="0.4"/>
                    
                    <Path x:Name="SunsetZoneArc" 
                          Stroke="#FF6B47" StrokeThickness="2" 
                          Fill="Transparent" Opacity="0.4"/>
                </Canvas>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>